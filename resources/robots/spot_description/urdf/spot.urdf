<?xml version="1.0" ?>
<robot name="spot">

    <link name="body">
        <inertial>
            <mass value="11.44"/>  <!-- Estimated body mass -->
            <origin xyz="0 0  0"/>  
            <inertia ixx="0.3" iyy="0.9" izz="0.9" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>

        <visual>
            <geometry>
                <mesh filename="../meshes/body.dae" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0." rpy="0 0 0"/>
            <geometry>
                <box size="0.4 0.2 0.15"/> 
            </geometry>
        </collision>

    </link>

    <link name="base_link"/>
    <joint name="base_link_joint" type="fixed">
        <origin xyz="0 0 0.05" rpy="0 0 0" />
        <parent link="body" />
        <child link="base_link" />
    </joint>

    <!-- Front Left Leg -->
    <link name="front_left_hip">
        <inertial>
            <mass value="4.29"/>  <!-- Estimated leg mass -->
            <origin xyz="0 0 0.05"/>  <!-- Center of mass at joint -->
            <inertia ixx="0.129" iyy="0.129" izz="0.129" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>

        <visual>
            <geometry>
                <mesh filename="../meshes/front_left_hip.dae" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="../meshes/front_left_hip_collision.stl" />
            </geometry>
        </collision>
    </link>
    <joint name="front_left_hip_x" type="revolute">
        <origin xyz="0.29785 0.05500 0.05" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <parent link="body"/>
        <child link="front_left_hip"/>
        <limit effort="1000" velocity="1000.00" lower="-0.7854" upper="0.7854"/>
    </joint>

    <link name="front_left_upper_leg">
        <visual>
            <geometry>
                <mesh filename="../meshes/front_left_upper_leg.dae" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="../meshes/front_left_upper_leg_collision.stl" />
            </geometry>
        </collision>
    </link>
    <joint name="front_left_hip_y" type="revolute">
        <origin xyz="0.0 0.110945 0.0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <parent link="front_left_hip"/>
        <child link="front_left_upper_leg"/>
        <limit effort="1000" velocity="1000.00" lower="-0.8988" upper="2.2951"/>
    </joint>

    <link name="front_left_lower_leg">
        <visual>
            <geometry>
                <mesh filename="../meshes/front_left_lower_leg.dae" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="../meshes/front_left_lower_leg_collision.stl" />
            </geometry>
        </collision>
    </link>
    <joint name="front_left_knee" type="revolute">
        <origin xyz="0.025 0.000 -0.25" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <parent link="front_left_upper_leg"/>
        <child link="front_left_lower_leg"/>
        <limit effort="1000" velocity="1000.00" lower="-2.7929" upper="-0.2548"/>
    </joint>

    <link name="front_left_foot">
        <visual>
            <geometry>
                <mesh filename="../meshes/front_left_foot.dae" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -0.03" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.03"/> 
            </geometry>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <origin xyz="0 0 -0.01" />
            <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="front_left_foot_joint" type="fixed">
        <origin xyz="0 0 -0.03" rpy="0 0 0"/>
        <parent link="front_left_lower_leg"/>
        <child link="front_left_foot"/>
    </joint>



    <!-- Front Right Leg -->
    <link name="front_right_hip">
         <inertial>
            <mass value="4.29"/>  <!-- Estimated right mass -->
            <origin xyz="0 0 0.05"/>  <!-- Center of mass at joint -->
            <inertia ixx="0.129" iyy="0.129" izz="0.129" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>

        <visual>
            <geometry>
                <mesh filename="../meshes/front_right_hip.dae" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="../meshes/front_right_hip_collision.stl" />
            </geometry>
        </collision>
    </link>
    <joint name="front_right_hip_x" type="revolute">
        <origin xyz="0.29785 -0.05500 0.00000" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <parent link="body"/>
        <child link="front_right_hip"/>
        <limit effort="1000" velocity="1000.00" lower="-0.7854" upper="0.7854"/>
