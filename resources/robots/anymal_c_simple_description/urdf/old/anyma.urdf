<?xml version="1.0" encoding="utf-8"?>
<robot name="anymal">

  <!-- =======================
       BASE
       ======================= -->
  <link name="base">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/base.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>

    <!-- base collision approximations -->
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.58 0.14 0.18"/></geometry>
    </collision>
    <collision>
      <origin rpy="0 1.57079632679 0" xyz="0.2175 0.07 0"/>
      <geometry><cylinder length="0.145" radius="0.09"/></geometry>
    </collision>
    <collision>
      <origin rpy="0 1.57079632679 0" xyz="-0.2175 0.07 0"/>
      <geometry><cylinder length="0.145" radius="0.09"/></geometry>
    </collision>
    <collision>
      <origin rpy="0 1.57079632679 0" xyz="0.2175 -0.07 0"/>
      <geometry><cylinder length="0.145" radius="0.09"/></geometry>
    </collision>
    <collision>
      <origin rpy="0 1.57079632679 0" xyz="-0.2175 -0.07 0"/>
      <geometry><cylinder length="0.145" radius="0.09"/></geometry>
    </collision>
  </link>

