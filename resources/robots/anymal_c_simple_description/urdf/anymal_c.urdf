<?xml version="1.0"?>
<robot name="anymalc_go1style" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =======================
       base -> floating_base (fixed) -> trunk
       ======================= -->
  <link name="base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.001 0.001 0.001"/></geometry>
    </visual>
  </link>

  <joint name="floating_base" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="trunk"/>
  </joint>

  <!-- =======================
       TRUNK
       ======================= -->
  <link name="trunk">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/base.dae" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.4 0.2 0.1"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.17" ixy="0" ixz="0"
               iyy="0.7" iyz="0"
               izz="0.7"/>
    </inertial>
  </link>

  <!-- Top Shell -->
  <joint name="trunk_top_shell" type="fixed">
    <parent link="trunk"/>
    <child link="top_shell"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <link name="top_shell">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="../meshes/top_shell.dae" scale="1 1 1"/></geometry>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Bottom Shell -->
  <joint name="trunk_bottom_shell" type="fixed">
    <parent link="trunk"/>
    <child link="bottom_shell"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <link name="bottom_shell">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="../meshes/bottom_shell.dae" scale="1 1 1"/></geometry>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Battery -->
  <joint name="trunk_battery" type="fixed">
    <parent link="trunk"/>
    <child link="battery"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <link name="battery">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="../meshes/battery.dae" scale="1 1 1"/></geometry>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- IMU -->
  <joint name="imu_joint" type="fixed">
    <parent link="trunk"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0"
               izz="1e-6"/>
    </inertial>
  </link>

  <!-- =========================================================
       GO1 NAMING with ANYmal C visuals
       ========================================================= -->

  <!-- ================= FL (Front Left) ================= -->
  <joint name="FL_hip_joint" type="revolute">
    <origin xyz="0.2994 0.104 0.0" rpy="0 0 0"/>
    <parent link="trunk"/>
    <child link="FL_hip"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="1.0" friction="0.0"/>
    <limit effort="33.5" velocity="21.0" lower="-0.863" upper="0.863"/>
  </joint>

  <link name="FL_hip">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/hip_l.dae" scale="1 1 1"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0.04 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder length="0.04" radius="0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.08 0" rpy="0 0 0"/>
      <mass value="0.696"/>
      <inertia ixx="0.00046" ixy="0" ixz="0" 
               iyy="0.000559" iyz="0" 
               izz="0.00046"/>
    </inertial>
  </link>

  <joint name="FL_thigh_joint" type="revolute">
    <origin xyz="0.0 0.08505 0.0" rpy="0 0 0"/>
    <parent link="FL_hip"/>
    <child link="FL_thigh"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="1.0" friction="0.0"/>
    <limit effort="33.5" velocity="21.0" lower="-1.5708" upper="3.4907"/>
  </joint>

  <link name="FL_thigh">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/thigh.dae" scale="1 1 1"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.25"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <mass value="1.013"/>
      <inertia ixx="0.00552929" ixy="0" ixz="0" 
               iyy="0.00552929" iyz="0" 
               izz="0.00073"/>
    </inertial>
  </link>

  <joint name="FL_calf_joint" type="revolute">
    <origin xyz="0 0.1003 -0.285" rpy="0 0 0"/>
    <parent link="FL_thigh"/>
    <child link="FL_calf"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="1.0" friction="0.0"/>
    <limit effort="33.5" velocity="21.0" lower="-2.7227" upper="-0.83776"/>
  </joint>

  <link name="FL_calf">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/shank_l.dae" scale="1 1 1"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.25"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <mass value="0.226"/>
      <inertia ixx="0.00299" ixy="0" ixz="0" 
               iyy="0.00299" iyz="0" 
               izz="0.00007"/>
    </inertial>
  </link>

  <joint name="FL_foot_fixed" type="fixed" dont_collapse="true">
    <origin xyz="0.08795 0.01305 -0.33797" rpy="0 0 0"/>
    <parent link="FL_calf"/>
    <child link="FL_foot"/>
  </joint>

  <link name="FL_foot">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -0.785398163397"/>
      <geometry><mesh filename="../meshes/foot.dae" scale="1 1 1"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" 
               iyy="0.000001" iyz="0" 
               izz="0.000001"/>
    </inertial>
  </link>

  <!-- ================= FR (Front Right) ================= -->
  <joint name="FR_hip_joint" type="revolute">
